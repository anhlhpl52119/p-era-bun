{
  "name": "electrobun-vue",
  "type": "module",
  "version": "1.0.0",
  "description": "Electrobun app with Vue and Vite HMR",
  "scripts": {
    "start": "bun run build:view && electrobun dev",
    "dev": "bun run build:view && concurrently --kill-others --names vite,electrobun \"bun run hmr\" \"wait-on --timeout 30000 http://localhost:5173 && electrobun dev\"",
    "hmr": "vite --host localhost --port 5173",
    "typecheck:app": "vue-tsc -p tsconfig.app.json --noEmit",
    "typecheck:bun": "tsc -p tsconfig.bun.json --noEmit",
    "typecheck:build": "tsc -p tsconfig.build.json --noEmit",
    "typecheck": "bun run typecheck:app && bun run typecheck:bun && bun run typecheck:build",
    "build:view": "vite build",
    "build:dev": "bun run typecheck && bun run build:view && electrobun build --env=dev",
    "build:canary": "bun run typecheck && bun run build:view && electrobun build --env=canary",
    "build:stable": "bun run typecheck && bun run build:view && electrobun build --env=stable",
    "build": "bun run build:stable",
    "history:backfill": "bun scripts/backfill-commit-history.ts"
  },
  "dependencies": {
    "@lucide/vue": "^1.34.0",
    "@rive-app/webgl2": "^2.40.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/node-toolbar": "^1.1.1",
    "@vueuse/core": "^14.4.0",
    "ai": "^7.0.79",
    "ansi-to-vue3": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electrobun": "1.18.1",
    "embla-carousel-vue": "^8.6.0",
    "lucide": "^1.33.0",
    "media-chrome": "^4.19.2",
    "morphicons": "^1.7.0",
    "motion-v": "^2.4.0",
    "nanoid": "^6.0.1",
    "pinia": "^4.0.3",
    "reka-ui": "^2.10.4",
    "shadcn-vue": "^2.8.2",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tokenlens": "^1.3.1",
    "vue-router": "^5.2.0",
    "vue-stick-to-bottom": "^1.0.1",
    "vue-stream-markdown": "^1.0.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.2.0",
    "@types/bun": "latest",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.7.0",
    "eslint-plugin-format": "^2.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vite": "^6.0.3",
    "vue": "^3.5.39",
    "vue-tsc": "^3.3.5",
    "wait-on": "^9.1.0"
  }
}
